{
  "name": "educar-para-transformar",
  "private": true,
  "version": "1.0.0",
  "description": "Sprint 1 del sistema de gestion de EDUCAR PARA TRANSFORMAR",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace @educar/api",
    "dev:web": "npm run dev --workspace @educar/web",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspace @educar/api",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:coverage": "npm run test:coverage --workspace @educar/api",
    "e2e": "cypress run",
    "e2e:open": "cypress open",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "cypress": "^13.17.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "typescript-eslint": "^8.72.1",
    "wait-on": "^9.5.1"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs}": "eslint --max-warnings=20"
  }
}
