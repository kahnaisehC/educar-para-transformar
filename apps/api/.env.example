PORT=4000
DATABASE_URL=postgres://educar:educar_dev_password@localhost:5432/educar
JWT_SECRET=replace-this-with-a-long-random-secret
CORS_ORIGIN=http://localhost:5173,http://localhost:8081

# App móvil / recuperación de contraseña
APP_URL=http://localhost:5173
UPLOADS_DIR=uploads

# Correo (si SMTP_HOST está vacío se usa un transporte de prueba)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=EDUCAR PARA TRANSFORMAR <no-reply@educar.local>

# Datos bancarios para transferencias
BANK_ALIAS=EDUCAR.CUOTAS
BANK_CBU=0000003100010000000001
BANK_HOLDER=Centro Educativo Educar para Transformar

# Token para el runner programado de notificaciones (GitHub Actions)
NOTIFICATIONS_TOKEN=replace-with-a-long-random-token

# Storage de comprobantes: local (desarrollo) o s3 (Render/producción)
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY=
S3_SECRET_KEY=
